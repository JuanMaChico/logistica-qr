# Backend (@logistica/api) — variables de entorno
# Copiá este archivo a apps/api/.env y completá los valores.

# Conexión a PostgreSQL. Debe coincidir con docker-compose.yml (user/pass/db).
# En Neon (producción) usá la connection string POOLED para la app.
DATABASE_URL="postgresql://logistica:logistica@localhost:5432/logistica_qr?schema=public"

# Secreto para firmar los JWT. OBLIGATORIO: el backend falla al arrancar si falta.
# Generá uno seguro:  openssl rand -hex 32
JWT_SECRET="cambiar-por-un-secreto-seguro"

# Origen permitido por CORS (frontend). Obligatorio en producción (NODE_ENV=production);
# en dev, si no se define, usa '*'.
CORS_ORIGIN="http://localhost:5173"

# Puerto del backend. Por defecto 3000.
PORT=3000

# Auto-registro de organizaciones (SaaS). Apagado por defecto (deploy de una sola
# empresa): el owner se crea por seed. Poné 'true' para habilitar POST /auth/register.
ALLOW_REGISTRATION=false

# Credenciales del owner para el seed (prisma db seed).
# En producción SEED_ADMIN_PASSWORD es obligatorio (no se siembra admin123).
SEED_ADMIN_EMAIL="admin@tuempresa.com"
SEED_ADMIN_PASSWORD="cambiar-por-un-password-fuerte"
SEED_ORG_NAME="Mi Empresa"
SEED_ORG_SLUG="mi-empresa"
