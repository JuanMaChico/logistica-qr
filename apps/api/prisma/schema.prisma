generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  technician
}

enum EquipmentCategory {
  speaker
  microphone
  cable
  screen
  other
}

enum PhysicalStatus {
  good
  damaged
  in_repair
}

enum AvailabilityStatus {
  available
  rented
  retired
}

enum EventType {
  party
  business_meeting
  show
  other
}

enum EventStatus {
  pending
  in_progress
  partial_return
  completed
}

enum RentalStatus {
  reserved
  active
  returned
}

enum ReturnCondition {
  good
  damaged
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  equipment Equipment[]
  events    Event[]
  clients   Client[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  email          String?  @unique
  password       String?
  pin            String?
  role           Role     @default(technician)
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization    Organization   @relation(fields: [organizationId], references: [id])
  createdEvents   Event[]        @relation("EventCreator")
  assignedRentals Rental[]       @relation("AssignedTechnician")
  registeredBails EquipmentLog[] @relation("BailRegistrar")

  @@map("users")
}

model Equipment {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  qrCode             String             @unique
  name               String
  category           EquipmentCategory
  physicalStatus     PhysicalStatus     @default(good) @map("physical_status")
  availabilityStatus AvailabilityStatus @default(available) @map("availability_status")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id])
  rentalItems  RentalItem[]
  bails        EquipmentLog[]

  @@map("equipment")
}

model Client {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  events       Event[]

  @@map("clients")
}

model Event {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  name           String
  type           EventType
  clientId       String?     @map("client_id")
  clientName     String      @map("client_name")
  clientPhone    String?     @map("client_phone")
  clientAddress  String?     @map("client_address")
  departureDate  DateTime    @map("departure_date")
  returnDate     DateTime    @map("return_date")
  status         EventStatus @default(pending)
  notes          String?
  createdById    String      @map("created_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id])
  client       Client?        @relation(fields: [clientId], references: [id])
  createdBy    User           @relation("EventCreator", fields: [createdById], references: [id])
  rentals      Rental[]
  bails        EquipmentLog[]

  @@map("events")
}

model Rental {
  id               String       @id @default(uuid())
  eventId          String       @map("event_id")
  technicianId     String       @map("technician_id")
  departureDate    DateTime     @map("departure_date")
  returnDate       DateTime     @map("return_date")
  actualReturnDate DateTime?    @map("actual_return_date")
  status           RentalStatus @default(active)
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at")

  event      Event        @relation(fields: [eventId], references: [id])
  technician User         @relation("AssignedTechnician", fields: [technicianId], references: [id])
  items      RentalItem[]

  @@map("rentals")
}

model RentalItem {
  id              String           @id @default(uuid())
  rentalId        String           @map("rental_id")
  equipmentId     String           @map("equipment_id")
  scannedOutAt    DateTime         @map("scanned_out_at")
  scannedInAt     DateTime?        @map("scanned_in_at")
  returnCondition ReturnCondition? @map("return_condition")
  returnNotes     String?          @map("return_notes")

  rental    Rental    @relation(fields: [rentalId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@map("rental_items")
}

model EquipmentLog {
  id             String   @id @default(uuid())
  equipmentId    String   @map("equipment_id")
  eventId        String?  @map("event_id")
  reason         String
  registeredById String   @map("registered_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  equipment Equipment @relation(fields: [equipmentId], references: [id])
  event     Event?    @relation(fields: [eventId], references: [id])
  registrar User      @relation("BailRegistrar", fields: [registeredById], references: [id])

  @@map("equipment_logs")
}
